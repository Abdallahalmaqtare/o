# =====================================================
# Aboud Trading Bot - Environment Variables
# =====================================================

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
ADMIN_USER_IDS=12345678,87654321

# Pocket Option
# Get SSID from browser (Network tab -> WS -> 42["auth",...])
PO_SSID='42["auth",{"session":"your_session_id","isDemo":1,"uid":12345,"platform":1}]'
PO_IS_DEMO=true
PO_ANALYSIS_INTERVAL=60

# App Settings
SIGNALS_ENABLED=true
BOT_UTC_OFFSET=3
DAILY_REPORT_HOUR=18
PORT=10000
DEBUG=false

# Database (Optional for Render, uses SQLite by default)
# DATABASE_URL=postgres://user:pass@host:port/dbname
